<Window x:Class="ContextFlow.Views.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ContextFlow"
        Width="96"
        Height="96"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AutomationProperties.Name="Open ContextFlow workspace HUD"
        AutomationProperties.HelpText="Press Control E F to open ContextFlow">

    <Grid x:Name="Root"
          Width="96"
          Height="96"
          Opacity="1"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <ToolTipService.InitialShowDelay>350</ToolTipService.InitialShowDelay>
        <Grid.ToolTip>
            <ToolTip Placement="Left">
                <StackPanel>
                    <TextBlock Text="ContextFlow"
                               FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="12"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding HudShortcutLabel}"
                               Margin="0,3,0,0"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="10"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{DynamicResource BubbleHint}"
                               Margin="0,3,0,0"
                               FontSize="9.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </ToolTip>
        </Grid.ToolTip>

        <!-- Pulsing attention halo, deliberately slow to remain unobtrusive. -->
        <Ellipse x:Name="Halo"
                 Width="64"
                 Height="64"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="Transparent"
                 Stroke="{DynamicResource AccentBrush}"
                 StrokeThickness="1"
                 Opacity="0.28">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="HaloScale" CenterX="32" CenterY="32" ScaleX="1" ScaleY="1" />
            </Ellipse.RenderTransform>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="Halo"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.28"
                                             To="0.06"
                                             Duration="0:0:2.8">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HaloScale"
                                             Storyboard.TargetProperty="ScaleX"
                                             From="1"
                                             To="1.14"
                                             Duration="0:0:2.8">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HaloScale"
                                             Storyboard.TargetProperty="ScaleY"
                                             From="1"
                                             To="1.14"
                                             Duration="0:0:2.8">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>

        <Border x:Name="BubbleSurface"
                Width="64"
                Height="64"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource BubbleGradientBrush}"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="32"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="22"
                                  ShadowDepth="0"
                                  Opacity="0.45"
                                  Color="#6366F1" />
            </Border.Effect>
            <Grid>
                <Border Margin="2"
                        Background="#18FFFFFF"
                        CornerRadius="30" />
                <Grid Width="30"
                      Height="24"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Border Height="3"
                            VerticalAlignment="Top"
                            Background="#F2FFFFFF"
                            CornerRadius="1.5" />
                    <Border Height="2.4"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Background="#8CFFFFFF"
                            CornerRadius="1.2" />
                    <Border Height="3"
                            VerticalAlignment="Bottom"
                            Background="#F2FFFFFF"
                            CornerRadius="1.5" />
                    <Ellipse Width="7"
                             Height="7"
                             Margin="0,0,1,0"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Fill="#F2C45A" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="CountBadge"
                MinWidth="20"
                Height="18"
                Margin="0,0,8,8"
                Padding="5,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="9"
                ToolTip="{DynamicResource ManagedWindows}">
            <TextBlock Text="{Binding BubbleCountText}"
                       FontFamily="{StaticResource MonoFontFamily}"
                       FontSize="8.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
