<Window x:Class="ContextFlow.Views.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ContextFlow.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ContextFlow"
        Width="1320"
        Height="820"
        MinWidth="1160"
        MinHeight="640"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource BodyFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        PreviewKeyDown="Window_OnPreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="72"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding Commands.Collapse}" />
        <KeyBinding Key="F" Modifiers="Control+Shift" Command="{Binding Commands.OptimizeNow}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="CapsuleActiveStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource CapsuleTileStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{Binding AccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <Border x:Name="Shell"
                Background="{DynamicResource HudBackgroundBrush}"
                BorderBrush="{DynamicResource WindowBorderBrush}"
                BorderThickness="1.5"
                CornerRadius="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>

                <!-- Brushed-metal sheen, chrome title band and footer band. -->
                <Border Grid.RowSpan="3"
                        CornerRadius="19"
                        Background="{DynamicResource MetalSheenBrush}"
                        IsHitTestVisible="False" />
                <Border Grid.Row="0"
                        CornerRadius="19,19,0,0"
                        Background="{DynamicResource HeaderBrush}"
                        BorderBrush="{DynamicResource ChromeEdgeBrush}"
                        BorderThickness="0,0,0,1"
                        IsHitTestVisible="False" />
                <Border Grid.Row="2"
                        CornerRadius="0,0,19,19"
                        Background="{DynamicResource HeaderBrush}"
                        BorderBrush="{DynamicResource ChromeEdgeBrush}"
                        BorderThickness="0,1,0,0"
                        Opacity="0.85"
                        IsHitTestVisible="False" />

                <!-- ============================ HEADER ============================ -->
                <Grid x:Name="HeaderBar"
                      Grid.Row="0"
                      Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="22,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="36"
                                Height="36"
                                Background="{DynamicResource AccentGradientBrush}"
                                CornerRadius="11">
                            <Grid Width="22" Height="18">
                                <Border Height="2.6"
                                        VerticalAlignment="Top"
                                        Background="#F2FFFFFF"
                                        CornerRadius="1.3" />
                                <Border Height="2.2"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Background="#8CFFFFFF"
                                        CornerRadius="1.1" />
                                <Border Height="2.6"
                                        VerticalAlignment="Bottom"
                                        Background="#F2FFFFFF"
                                        CornerRadius="1.3" />
                                <Ellipse Width="5.5"
                                         Height="5.5"
                                         Margin="0,0,0,0"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Fill="#F2C45A" />
                            </Grid>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ContextFlow"
                                       FontFamily="{StaticResource DisplayFontFamily}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource BrandSubtitle}"
                                       Margin="0,2,0,0"
                                       FontSize="8"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <RadioButton GroupName="HudTabs"
                                     Style="{StaticResource FilterChipStyle}"
                                     shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                     Content="{DynamicResource TabWorkspace}"
                                     IsChecked="{Binding IsWorkspaceTab, Mode=TwoWay}" />
                        <RadioButton GroupName="HudTabs"
                                     Margin="8,0,0,0"
                                     Style="{StaticResource FilterChipStyle}"
                                     shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                     Content="{DynamicResource TabPerformance}"
                                     IsChecked="{Binding IsPerformanceTab, Mode=TwoWay}" />
                        <RadioButton GroupName="HudTabs"
                                     Margin="8,0,0,0"
                                     Style="{StaticResource FilterChipStyle}"
                                     shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                     Content="{DynamicResource TabSettings}"
                                     IsChecked="{Binding IsSettingsTab, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Margin="0,0,16,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border x:Name="AiStatusChip"
                                Height="30"
                                Margin="0,0,10,0"
                                Padding="10,0"
                                CornerRadius="8"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOptimizationEnabled}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOptimizationEnabled}" Value="False">
                                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{DynamicResource LocalAi}"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding AiStatusText}"
                                           Margin="5,0,0,0"
                                           FontSize="8.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <Border.ToolTip>
                                <TextBlock Text="{Binding AiStatusDetail}" />
                            </Border.ToolTip>
                        </Border>

                        <Button Style="{StaticResource IconButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Content="{Binding ThemeIconGlyph}"
                                FontFamily="Segoe UI Symbol"
                                FontSize="15"
                                AutomationProperties.Name="Toggle light or dark theme"
                                Command="{Binding Commands.ToggleTheme}"
                                ToolTip="{DynamicResource TooltipTheme}" />
                        <Button Height="32"
                                Margin="8,0,8,0"
                                Padding="13,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Content="{DynamicResource OptimizeNow}"
                                FontSize="9.5"
                                Command="{Binding Commands.OptimizeNow}"
                                ToolTip="{DynamicResource TooltipOptimize}" />
                        <Button x:Name="MaximizeButton"
                                Margin="0,0,8,0"
                                Style="{StaticResource IconButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Content="□"
                                FontFamily="Segoe UI Symbol"
                                FontSize="14"
                                AutomationProperties.Name="Maximize or restore HUD"
                                Click="MaximizeButton_OnClick"
                                ToolTip="{DynamicResource TooltipMaximize}" />
                        <Button Style="{StaticResource IconButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Content="—"
                                FontFamily="{StaticResource BodyFontFamily}"
                                FontSize="16"
                                AutomationProperties.Name="Collapse HUD to floating bubble"
                                Command="{Binding Commands.Collapse}"
                                ToolTip="{DynamicResource TooltipCollapse}" />
                    </StackPanel>
                </Grid>

                <!-- ============================ BODY ============================ -->
                <Grid Grid.Row="1"
                      Margin="18,16,18,10"
                      Visibility="{Binding IsWorkspaceTab, Converter={StaticResource BooleanToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="244" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="294" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT RAIL -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="2,0,2,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource WorkflowPages}" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="{Binding CapsuleSummary}"
                                           Margin="0,3,0,0"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource IconButtonStyle}"
                                    Width="28"
                                    Height="28"
                                    Content="+"
                                    FontSize="17"
                                    AutomationProperties.Name="Create workflow capsule"
                                    Command="{Binding Commands.AddCapsule}"
                                    ToolTip="{DynamicResource TooltipAddPage}" />
                        </Grid>

                        <Border Grid.Row="1"
                                Style="{StaticResource CardStyle}"
                                Padding="8"
                                CornerRadius="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <ItemsControl ItemsSource="{Binding Capsules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource CapsuleActiveStyle}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Activate capsule {0}}"
                                                    Command="{Binding DataContext.Commands.ActivateCapsule, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{DynamicResource TooltipActivatePage}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="4"
                                                            Height="32"
                                                            Background="{Binding AccentBrush}"
                                                            CornerRadius="2" />
                                                    <StackPanel Grid.Column="1" Margin="10,0,6,0">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="11.5"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <Border Margin="7,0,0,0"
                                                                    Padding="5,1"
                                                                    Background="{Binding AccentSoftBrush}"
                                                                    CornerRadius="4">
                                                                <TextBlock Text="{DynamicResource Active}"
                                                                           FontSize="7.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="{Binding AccentBrush}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="{x:Type TextBlock}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </DockPanel>
                                                        <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                            <TextBlock Text="{Binding WindowCountText}"
                                                                       FontSize="9"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="  ·  "
                                                                       FontSize="9"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                                            <TextBlock Text="{Binding TargetDisplayLabel}"
                                                                       Width="116"
                                                                       FontSize="9"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Ellipse Grid.Column="2"
                                                             Width="7"
                                                             Height="7"
                                                             Margin="0,0,2,0"
                                                             Fill="{Binding AccentBrush}"
                                                             VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="{x:Type Ellipse}">
                                                                <Setter Property="Opacity" Value="0.22" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Display router -->
                        <Border Grid.Row="2"
                                Style="{StaticResource CardStyle}"
                                Margin="0,12,0,0"
                                Padding="14,12"
                                CornerRadius="14">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{DynamicResource RouteActivePage}" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBlock HorizontalAlignment="Right"
                                               Text="{DynamicResource Drag}"
                                               FontSize="7.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </Grid>
                                <controls:MonitorRouteControl Height="58"
                                                              Margin="0,9,0,0"
                                                              AutomationProperties.Name="Active capsule monitor router"
                                                              ItemsSource="{Binding Displays}"
                                                              SelectedIndex="{Binding ActiveDisplayIndex, Mode=TwoWay}"
                                                              AccentBrush="{DynamicResource AccentBrush}"
                                                              TrackBrush="{DynamicResource SurfaceMutedBrush}"
                                                              SurfaceBrush="{DynamicResource SurfaceBrush}"
                                                              TextBrush="{DynamicResource TextPrimaryBrush}"
                                                              MutedTextBrush="{DynamicResource TextSecondaryBrush}"
                                                              BorderBrush="{DynamicResource BorderBrush}" />
                                <TextBlock Text="{Binding ActiveCapsuleDisplayLabel}"
                                           Margin="0,7,0,0"
                                           FontSize="9"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- AI control -->
                        <Border Grid.Row="3"
                                Style="{StaticResource CardStyle}"
                                Margin="0,12,0,0"
                                Padding="14,12"
                                CornerRadius="14">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{DynamicResource LocalAiOptimizer}" Style="{StaticResource EyebrowTextStyle}" />
                                    <Border HorizontalAlignment="Right"
                                            Padding="6,1"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="4">
                                        <TextBlock Text="{Binding EngineLabel}"
                                                   FontSize="7.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{DynamicResource OfflinePolicy}"
                                           Margin="0,3,0,0"
                                           FontSize="9"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource AutoOptimize}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource ThrottleIdlePages}"
                                                   FontSize="8.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Style="{StaticResource SwitchToggleStyle}"
                                                  AutomationProperties.Name="Toggle automatic AI optimization"
                                                  IsChecked="{Binding IsOptimizationEnabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="{DynamicResource TooltipAutoOptimize}" />
                                </Grid>

                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource PageIsolation}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource IsolationDetail}"
                                                   FontSize="8.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Style="{StaticResource SwitchToggleStyle}"
                                                  AutomationProperties.Name="Toggle inactive capsule isolation"
                                                  IsChecked="{Binding IsCapsuleIsolationEnabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Opt-in: hides inactive capsule windows. Tries DWM cloaking first; if Windows denies cross-process cloaking, uses a reversible minimize and restores it on capsule activation or exit." />
                                </Grid>

                                <DockPanel Margin="0,11,0,0">
                                    <Button DockPanel.Dock="Right"
                                            Height="28"
                                            Padding="10,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            FontSize="9"
                                            Content="{DynamicResource RunPass}"
                                            Command="{Binding Commands.OptimizeNow}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource WorkingSetPriority}"
                                                   FontSize="8.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding IsolationStatusText}"
                                                   FontSize="7.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- CENTER -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="154" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- CPU -->
                            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{DynamicResource CpuBrush}" />
                                            <TextBlock Text="CPU" Style="{StaticResource EyebrowTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource Live}"
                                                   HorizontalAlignment="Right"
                                                   FontSize="7.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="68" Height="68" VerticalAlignment="Center">
                                            <controls:GaugeArc Value="{Binding CpuPercent}"
                                                               AccentBrush="{DynamicResource CpuBrush}"
                                                               TrackBrush="{DynamicResource TrackBrush}" />
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CpuValueText}"
                                                           FontFamily="{StaticResource DisplayFontFamily}"
                                                           FontSize="20"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="%"
                                                           Margin="1,6,0,0"
                                                           FontSize="8"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CpuDetail}"
                                                       FontSize="8.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                            <controls:Sparkline Height="23"
                                                                Margin="0,5,0,0"
                                                                Points="{Binding CpuHistory}"
                                                                StrokeBrush="{DynamicResource CpuBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- RAM -->
                            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="6,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{DynamicResource RamBrush}" />
                                            <TextBlock Text="{DynamicResource Memory}" Style="{StaticResource EyebrowTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Text="RAM"
                                                   HorizontalAlignment="Right"
                                                   FontSize="7.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="68" Height="68" VerticalAlignment="Center">
                                            <controls:GaugeArc Value="{Binding RamPercent}"
                                                               AccentBrush="{DynamicResource RamBrush}"
                                                               TrackBrush="{DynamicResource TrackBrush}" />
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RamValueText}"
                                                           FontFamily="{StaticResource DisplayFontFamily}"
                                                           FontSize="20"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="%"
                                                           Margin="1,6,0,0"
                                                           FontSize="8"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RamDetail}"
                                                       FontSize="8.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                            <controls:Sparkline Height="23"
                                                                Margin="0,5,0,0"
                                                                Points="{Binding RamHistory}"
                                                                StrokeBrush="{DynamicResource RamBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- GPU -->
                            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="6,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{DynamicResource GpuBrush}" />
                                            <TextBlock Text="GPU" Style="{StaticResource EyebrowTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Text="PDH"
                                                   HorizontalAlignment="Right"
                                                   FontSize="7.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="68" Height="68" VerticalAlignment="Center">
                                            <controls:GaugeArc Value="{Binding GpuPercent}"
                                                               AccentBrush="{DynamicResource GpuBrush}"
                                                               TrackBrush="{DynamicResource TrackBrush}" />
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GpuValueText}"
                                                           FontFamily="{StaticResource DisplayFontFamily}"
                                                           FontSize="20"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="%"
                                                           Margin="1,6,0,0"
                                                           FontSize="8"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GpuDetail}"
                                                       FontSize="8.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                            <controls:Sparkline Height="23"
                                                                Margin="0,5,0,0"
                                                                Points="{Binding GpuHistory}"
                                                                StrokeBrush="{DynamicResource GpuBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Windows -->
                            <Border Grid.Column="3"
                                    Margin="6,0,0,0"
                                    Padding="14"
                                    CornerRadius="15"
                                    BorderThickness="0"
                                    Background="{DynamicResource AccentGradientBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <TextBlock Text="{DynamicResource ManagedWindows}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="#D9FFFFFF" />
                                        <Ellipse Width="6"
                                                 Height="6"
                                                 HorizontalAlignment="Right"
                                                 Fill="#E6FFFFFF" />
                                    </DockPanel>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WindowCountText}"
                                                   FontFamily="{StaticResource DisplayFontFamily}"
                                                   FontSize="37"
                                                   FontWeight="SemiBold"
                                                   Foreground="White" />
                                        <TextBlock Text="{Binding WindowSummaryText}"
                                                   Margin="0,-2,0,0"
                                                   FontSize="8.5"
                                                   Foreground="#D9FFFFFF"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <Border Width="5" Height="5" CornerRadius="2.5" Background="#F2C45A" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource AcrossAllPages}"
                                                   FontSize="7.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#D9FFFFFF" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Process matrix -->
                        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" CornerRadius="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="34" />
                                </Grid.RowDefinitions>

                                <Grid Margin="16,12,16,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource ProcessMatrix}" Style="{StaticResource EyebrowTextStyle}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{DynamicResource ApplicationWindows}"
                                                       FontFamily="{StaticResource DisplayFontFamily}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <Border Margin="8,0,0,0"
                                                    Padding="6,1"
                                                    Background="{DynamicResource SurfaceMutedBrush}"
                                                    CornerRadius="5"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding VisibleWindowCountText}"
                                                           FontSize="8"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding CurrentWindowTitle}"
                                                       MaxWidth="280"
                                                       FontSize="8.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding CurrentWindowTitle}" />
                                            <TextBlock Text="{Binding WindowScrollPositionText, StringFormat=  ·  {0}}"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="8"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                            <TextBlock Text="{Binding ScrollShortcutHint}"
                                                       FontSize="7.5"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Width="28"
                                                Height="28"
                                                Margin="0,0,4,0"
                                                Style="{StaticResource IconButtonStyle}"
                                                Content="▲"
                                                FontFamily="Segoe UI Symbol"
                                                FontSize="9"
                                                AutomationProperties.Name="Previous managed window"
                                                Command="{Binding Commands.NavigatePreviousWindow}"
                                                ToolTip="{Binding PreviousHotkeyTooltip}" />
                                        <Button Width="28"
                                                Height="28"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource IconButtonStyle}"
                                                Content="▼"
                                                FontFamily="Segoe UI Symbol"
                                                FontSize="9"
                                                AutomationProperties.Name="Next managed window"
                                                Command="{Binding Commands.NavigateNextWindow}"
                                                ToolTip="{Binding NextHotkeyTooltip}" />
                                        <Border Width="158"
                                                Height="28"
                                                Margin="0,0,8,0"
                                                Padding="8,0"
                                                Background="{DynamicResource InputBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="⌕"
                                                           Margin="0,0,5,0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe UI Symbol"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                                <Grid Grid.Column="1">
                                                    <TextBox x:Name="SearchBox"
                                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                             VerticalAlignment="Center"
                                                             AutomationProperties.Name="Filter managed windows"
                                                             ToolTip="{DynamicResource TooltipSearch}" />
                                                    <TextBlock Text="{DynamicResource FilterWindows}"
                                                               IsHitTestVisible="False"
                                                               VerticalAlignment="Center"
                                                               FontSize="9.5"
                                                               Foreground="{DynamicResource TextTertiaryBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <RadioButton Content="{DynamicResource All}"
                                                     GroupName="WindowFilter"
                                                     Margin="0,0,5,0"
                                                     Style="{StaticResource FilterChipStyle}"
                                                     IsChecked="{Binding IsAllFilterSelected, Mode=TwoWay}" />
                                        <RadioButton Content="{DynamicResource PageFilter}"
                                                     GroupName="WindowFilter"
                                                     Style="{StaticResource FilterChipStyle}"
                                                     IsChecked="{Binding IsCapsuleFilterSelected, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1"
                                        Margin="16,0,16,0"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="98" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="66" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1"
                                                   Text="{DynamicResource WindowColumn}"
                                                   Style="{StaticResource EyebrowTextStyle}"
                                                   FontSize="8"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{DynamicResource ResourcesColumn}"
                                                   Style="{StaticResource EyebrowTextStyle}"
                                                   FontSize="8"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{DynamicResource PageColumn}"
                                                   Style="{StaticResource EyebrowTextStyle}"
                                                   FontSize="8"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{DynamicResource MonitorColumn}"
                                                   Style="{StaticResource EyebrowTextStyle}"
                                                   FontSize="8"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5"
                                                   Text="{DynamicResource PositionColumn}"
                                                   Style="{StaticResource EyebrowTextStyle}"
                                                   FontSize="8"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="6"
                                                   Text="{DynamicResource StateColumn}"
                                                   Style="{StaticResource EyebrowTextStyle}"
                                                   FontSize="8"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <ListView x:Name="ProcessList"
                                          Grid.Row="2"
                                          ItemsSource="{Binding WindowsView}"
                                          MouseDoubleClick="ProcessList_OnMouseDoubleClick"
                                          SelectionMode="Single"
                                          IsSynchronizedWithCurrentItem="False">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="54"
                                                    Padding="16,0"
                                                    BorderThickness="0,0,0,1">
                                                <Border.Style>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsScrollCurrent}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="98" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="66" />
                                                        <ColumnDefinition Width="28" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="26"
                                                            Height="26"
                                                            Background="{Binding CapsuleSoftBrush}"
                                                            CornerRadius="7"
                                                            VerticalAlignment="Center">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Initial}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding CapsuleBrush}" />
                                                            <Image Source="{Binding Icon}"
                                                                   Width="18"
                                                                   Height="18"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="1"
                                                                Margin="9,0,8,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Title}" />
                                                        <TextBlock Text="{Binding ProcessLabel}"
                                                                   Margin="0,2,0,0"
                                                                   FontSize="8.5"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding CpuText}"
                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                       FontSize="9"
                                                                       Foreground="{DynamicResource CpuBrush}" />
                                                            <TextBlock Text=" ↓"
                                                                       FontSize="9"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       ToolTip="{DynamicResource AppStateOptimized}"
                                                                       Visibility="{Binding IsAiOptimized, Converter={StaticResource BooleanToVisibility}}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding MemoryText}"
                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                   FontSize="7.5"
                                                                   Foreground="{DynamicResource RamBrush}" />
                                                    </StackPanel>

                                                    <Button Grid.Column="3"
                                                            Style="{StaticResource CapsulePillButtonStyle}"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="Change window capsule assignment"
                                                            Click="CapsulePill_OnClick"
                                                            ToolTip="{DynamicResource TooltipAssignPage}">
                                                        <Border Height="21"
                                                                Margin="0,0,9,0"
                                                                Padding="7,0"
                                                                Background="{Binding CapsuleSoftBrush}"
                                                                CornerRadius="6">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Ellipse Width="5" Height="5" Fill="{Binding CapsuleBrush}" Margin="0,0,5,0" />
                                                                <TextBlock Text="{Binding CapsuleName}"
                                                                           FontSize="8.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{Binding CapsuleBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="54" />
                                                                <TextBlock Text="⌄"
                                                                           Margin="3,-1,0,0"
                                                                           FontSize="8"
                                                                           Foreground="{Binding CapsuleBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Button>

                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding MonitorLabel}"
                                                               VerticalAlignment="Center"
                                                               FontSize="8.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding MonitorLabel}" />

                                                    <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CoordinatesLabel}"
                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                   FontSize="9"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding SizeLabel}"
                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                   FontSize="7.5"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="6"
                                                               Text="{Binding StatusLabel}"
                                                               VerticalAlignment="Center"
                                                               FontSize="7.5"
                                                               FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsForeground}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCloaked}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <Button Grid.Column="7"
                                                            Width="26"
                                                            Height="26"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Content="↗"
                                                            FontFamily="Segoe UI Symbol"
                                                            FontSize="11"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="Focus window"
                                                            Command="{Binding DataContext.Commands.FocusWindow, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{DynamicResource TooltipFocus}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Grid Grid.Row="2"
                                      IsHitTestVisible="False"
                                      Background="Transparent"
                                      Visibility="{Binding HasNoVisibleWindows, Converter={StaticResource BooleanToVisibility}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="36"
                                                Height="36"
                                                HorizontalAlignment="Center"
                                                Background="{DynamicResource SurfaceMutedBrush}"
                                                CornerRadius="10">
                                            <TextBlock Text="⌕"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe UI Symbol"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </Border>
                                        <TextBlock Text="{DynamicResource NoWindows}"
                                                   Margin="0,8,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource NoWindowsDetail}"
                                                   Margin="0,2,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="3" Margin="16,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource DoubleClickHint}"
                                                   FontSize="8.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Text="{Binding SystemStatusLabel}"
                                               FontSize="7.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- RIGHT RAIL -->
                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.18*" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0" CornerRadius="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Margin="14,12,14,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource PageMapEyebrow}" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="{DynamicResource PageMapTitle}"
                                                   Margin="0,2,0,0"
                                                   FontFamily="{StaticResource DisplayFontFamily}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Padding="7,2"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="5">
                                        <TextBlock Text="{DynamicResource Infinite}"
                                                   FontSize="7.5"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                </Grid>
                                <ScrollViewer Grid.Row="1"
                                              Margin="10,0,10,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False">
                                    <ItemsControl ItemsSource="{Binding Capsules}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource PageCardStyle}"
                                                        Margin="4"
                                                        Command="{Binding DataContext.Commands.GoToPage, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding Name, StringFormat=Go to page {0}}"
                                                        ToolTip="{Binding Name}">
                                                    <Grid Margin="9,8">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="{Binding PageLabel}"
                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                       FontSize="7.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="{Binding AccentBrush}" />
                                                            <Ellipse Width="5"
                                                                     Height="5"
                                                                     Margin="5,0,0,0"
                                                                     Fill="{Binding AccentBrush}">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="{x:Type Ellipse}">
                                                                        <Setter Property="Opacity" Value="0.25" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <Setter Property="Opacity" Value="1" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                        </DockPanel>
                                                        <controls:PageLayoutPreview Grid.Row="1"
                                                                                    Height="36"
                                                                                    Margin="0,6,0,6"
                                                                                    WindowCount="{Binding WindowCount}"
                                                                                    Layout="{Binding DataContext.PageLayout, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                                    AccentBrush="{Binding AccentBrush}"
                                                                                    SlotBrush="{DynamicResource SurfaceMutedBrush}" />
                                                        <StackPanel Grid.Row="2">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="9.5"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding WindowCountText}"
                                                                       Margin="0,1,0,0"
                                                                       FontSize="7.5"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Grid.Row="2"
                                           Margin="14,7,14,10"
                                           Text="{DynamicResource PageMapHint}"
                                           FontSize="7.8"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" CornerRadius="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="14,12,14,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource AiActivity}" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="{DynamicResource LocalPolicyJournal}"
                                                   Margin="0,2,0,0"
                                                   FontFamily="{StaticResource DisplayFontFamily}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Padding="6,1"
                                            Background="{DynamicResource SurfaceMutedBrush}"
                                            CornerRadius="5">
                                        <TextBlock Text="{DynamicResource OnDevice}"
                                                   FontSize="7.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                                <ScrollViewer Grid.Row="1"
                                              Margin="0,0,0,7"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False">
                                    <ItemsControl ItemsSource="{Binding Activity}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="14,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="24"
                                                            Height="24"
                                                            VerticalAlignment="Top"
                                                            Background="{DynamicResource SurfaceMutedBrush}"
                                                            CornerRadius="7">
                                                        <TextBlock Text="{Binding IconGlyph}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontFamily="Segoe UI Symbol"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0,6,0">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="{Binding ActionLabel}"
                                                                       FontSize="9.5"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="  ·  "
                                                                       FontSize="8"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                                            <TextBlock Text="{Binding ProcessName}"
                                                                       FontSize="8.5"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Detail}"
                                                                   Margin="0,1,0,0"
                                                                   FontSize="8"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Detail}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding TimeLabel}"
                                                               FontFamily="{StaticResource MonoFontFamily}"
                                                               FontSize="7.5"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               VerticalAlignment="Top" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ============================ PERFORMANCE ============================ -->
                <Grid Grid.Row="1"
                      Margin="18,16,18,10"
                      Visibility="{Binding IsPerformanceTab, Converter={StaticResource BooleanToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <!-- App consumption list -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" CornerRadius="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="20,16,20,12">
                                <TextBlock Text="{DynamicResource PerformanceEyebrow}" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="{DynamicResource PerformanceTitle}"
                                           Margin="0,3,0,0"
                                           FontFamily="{StaticResource DisplayFontFamily}"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding AppsSummaryText}"
                                           Margin="0,3,0,0"
                                           FontSize="9"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Margin="16,0,16,0"
                                    Padding="0,0,0,6"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid Margin="4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="232" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource AppColumn}" Style="{StaticResource EyebrowTextStyle}" FontSize="8" />
                                    <TextBlock Grid.Column="2" Text="CPU" Style="{StaticResource EyebrowTextStyle}" FontSize="8" />
                                    <TextBlock Grid.Column="3" Text="{DynamicResource Memory}" Style="{StaticResource EyebrowTextStyle}" FontSize="8" />
                                    <TextBlock Grid.Column="4" Text="{DynamicResource ActionsColumn}" Style="{StaticResource EyebrowTextStyle}" FontSize="8" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="2"
                                          Margin="0,0,0,10"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <ItemsControl ItemsSource="{Binding Apps}" Margin="16,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="52"
                                                    Padding="4,0"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="232" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="26"
                                                            Height="26"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource AccentSoftBrush}"
                                                            CornerRadius="7">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Initial}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AccentBrush}" />
                                                            <Border Background="{DynamicResource SurfaceBrush}"
                                                                    CornerRadius="7"
                                                                    Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibility}}">
                                                                <Image Source="{Binding Icon}"
                                                                       Width="18"
                                                                       Height="18"
                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="4,0,8,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="10.5"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="220" />
                                                            <Border Margin="7,0,0,0"
                                                                    Padding="6,1"
                                                                    CornerRadius="4"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding HasState, Converter={StaticResource BooleanToVisibility}}">
                                                                <Border.Style>
                                                                    <Style TargetType="{x:Type Border}">
                                                                        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsOptimized}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsPlayingAudio}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding StateText}" FontSize="7.5" FontWeight="Bold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="{x:Type TextBlock}">
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsOptimized}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsPlayingAudio}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding ProcessCountText}"
                                                                   Margin="0,2,0,0"
                                                                   FontSize="8.5"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CpuText}"
                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                   FontSize="9.5"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <Grid Width="96" Height="4" Margin="0,4,0,0" HorizontalAlignment="Left">
                                                            <Border Background="{DynamicResource TrackBrush}" CornerRadius="2" />
                                                            <Border Width="{Binding CpuBarWidth}"
                                                                    HorizontalAlignment="Left"
                                                                    Background="{DynamicResource CpuBrush}"
                                                                    CornerRadius="2" />
                                                        </Grid>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding MemoryText}"
                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                   FontSize="9.5"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <Grid Width="96" Height="4" Margin="0,4,0,0" HorizontalAlignment="Left">
                                                            <Border Background="{DynamicResource TrackBrush}" CornerRadius="2" />
                                                            <Border Width="{Binding MemoryBarWidth}"
                                                                    HorizontalAlignment="Left"
                                                                    Background="{DynamicResource RamBrush}"
                                                                    CornerRadius="2" />
                                                        </Grid>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="4"
                                                                Orientation="Horizontal"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center">
                                                        <Button Height="26"
                                                                Padding="10,0"
                                                                FontSize="8.5"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Content="{Binding OptimizeButtonText}"
                                                                IsEnabled="{Binding CanToggleOptimization}"
                                                                Command="{Binding DataContext.Commands.ToggleAppOptimization, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{DynamicResource TooltipOptimizeApp}" />
                                                        <Button Height="26"
                                                                Margin="6,0,0,0"
                                                                Padding="10,0"
                                                                FontSize="8.5"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Content="{Binding ProtectButtonText}"
                                                                Command="{Binding DataContext.Commands.ToggleAppProtection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{DynamicResource TooltipProtectApp}" />
                                                        <Button Width="26"
                                                                Height="26"
                                                                Margin="6,0,0,0"
                                                                Style="{StaticResource IconButtonStyle}"
                                                                Content="✕"
                                                                FontFamily="Segoe UI Symbol"
                                                                FontSize="10"
                                                                Foreground="{DynamicResource DangerBrush}"
                                                                AutomationProperties.Name="End application"
                                                                Command="{Binding DataContext.Commands.EndApp, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{DynamicResource TooltipEndApp}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- AI brain -->
                    <ScrollViewer Grid.Column="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}" Padding="18,16" CornerRadius="16">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{DynamicResource AiBrainEyebrow}" Style="{StaticResource EyebrowTextStyle}" />
                                        <Border HorizontalAlignment="Right"
                                                Padding="6,1"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="4">
                                            <TextBlock Text="{Binding EngineLabel}"
                                                       FontSize="7.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource AiBrainTitle}"
                                               Margin="0,3,0,0"
                                               FontFamily="{StaticResource DisplayFontFamily}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />

                                    <WrapPanel Margin="0,10,0,0">
                                        <Border Padding="8,3" CornerRadius="6" Margin="0,0,6,0">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AiPressure}" Value="High">
                                                            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AiPressure}" Value="Critical">
                                                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding AiPressureText}" FontSize="8.5" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AiPressure}" Value="High">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AiPressure}" Value="Critical">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Border Padding="8,3" CornerRadius="6" Margin="0,0,6,0" Background="{DynamicResource SurfaceMutedBrush}">
                                            <TextBlock Text="{Binding AiIntervalText}" FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <Border Padding="8,3" CornerRadius="6" Background="{DynamicResource SurfaceMutedBrush}">
                                            <TextBlock Text="{Binding AiPowerText}" FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </WrapPanel>

                                    <TextBlock Text="{DynamicResource AiProfileLabel}"
                                               Margin="0,14,0,0"
                                               FontSize="10.5"
                                               FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <RadioButton GroupName="AiProfileChoice"
                                                     Style="{StaticResource FilterChipStyle}"
                                                     Content="{DynamicResource ProfileConservative}"
                                                     IsChecked="{Binding IsProfileConservative, Mode=TwoWay}" />
                                        <RadioButton GroupName="AiProfileChoice"
                                                     Margin="6,0,0,0"
                                                     Style="{StaticResource FilterChipStyle}"
                                                     Content="{DynamicResource ProfileBalanced}"
                                                     IsChecked="{Binding IsProfileBalanced, Mode=TwoWay}" />
                                        <RadioButton GroupName="AiProfileChoice"
                                                     Margin="6,0,0,0"
                                                     Style="{StaticResource FilterChipStyle}"
                                                     Content="{DynamicResource ProfileAggressive}"
                                                     IsChecked="{Binding IsProfileAggressive, Mode=TwoWay}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding AiProfileDescription}"
                                               Margin="0,7,0,0"
                                               FontSize="9"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource AutoOptimize}" FontSize="10.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding AiStatusDetail}" FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Style="{StaticResource SwitchToggleStyle}"
                                                      AutomationProperties.Name="Toggle automatic AI optimization"
                                                      IsChecked="{Binding IsOptimizationEnabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Savings tiles -->
                            <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}" Padding="16,14" CornerRadius="16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource AiSavingsEyebrow}" Style="{StaticResource EyebrowTextStyle}" />
                                    <UniformGrid Margin="0,10,0,0" Columns="3" Rows="2">
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding AiOptimizedNowText}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Text="{DynamicResource StatOptimizedNow}" FontSize="8" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding AiReclaimedText}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource RamBrush}" />
                                            <TextBlock Text="{DynamicResource StatReclaimed}" FontSize="8" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding AiCpuContainedText}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource CpuBrush}" />
                                            <TextBlock Text="{DynamicResource StatCpuContained}" FontSize="8" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding AiActionsText}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Text="{DynamicResource StatActions}" FontSize="8" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding AiLearnedAppsText}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Text="{DynamicResource StatLearnedApps}" FontSize="8" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding AiAccuracyText}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
                                            <TextBlock Text="{DynamicResource StatAccuracy}" FontSize="8" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Insights -->
                            <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}" Padding="16,14" CornerRadius="16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource InsightsEyebrow}" Style="{StaticResource EyebrowTextStyle}" />
                                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Insights}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="22" Height="22" CornerRadius="11" VerticalAlignment="Top">
                                                        <Border.Style>
                                                            <Style TargetType="{x:Type Border}">
                                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Glyph}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontFamily="Segoe UI Symbol"
                                                                   FontSize="10">
                                                            <TextBlock.Style>
                                                                <Style TargetType="{x:Type TextBlock}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Detail}" Margin="0,2,0,0" FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button HorizontalAlignment="Left"
                                            Height="28"
                                            Padding="10,0"
                                            FontSize="8.5"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{DynamicResource ResetLearning}"
                                            Command="{Binding Commands.ResetLearning}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ============================ SETTINGS ============================ -->
                <Grid Grid.Row="1"
                      Margin="18,16,18,10"
                      Visibility="{Binding IsSettingsTab, Converter={StaticResource BooleanToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            Padding="24"
                            CornerRadius="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SettingsEyebrow}" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="{DynamicResource SettingsTitle}"
                                           Margin="0,4,0,0"
                                           FontFamily="{StaticResource DisplayFontFamily}"
                                           FontSize="26"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource SettingsSubtitle}"
                                           Margin="0,4,0,0"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />

                                <Border Margin="0,20,0,0"
                                        Padding="16"
                                        Background="{DynamicResource SurfaceSoftBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{DynamicResource FullScreenTitle}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{DynamicResource FullScreenDetail}"
                                                       Margin="0,3,0,0"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Style="{StaticResource SwitchToggleStyle}"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="Toggle full-screen workspaces"
                                                      IsChecked="{Binding IsAutoMaximizeEnabled, Mode=TwoWay}" />
                                    </Grid>
                                </Border>

                                <Border Margin="0,12,0,0"
                                        Padding="16"
                                        Background="{DynamicResource SurfaceSoftBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Language}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <RadioButton GroupName="LanguageChoice"
                                                         Style="{StaticResource FilterChipStyle}"
                                                         Content="{DynamicResource English}"
                                                         IsChecked="{Binding IsEnglish, Mode=TwoWay}" />
                                            <RadioButton GroupName="LanguageChoice"
                                                         Margin="8,0,0,0"
                                                         Style="{StaticResource FilterChipStyle}"
                                                         Content="{DynamicResource Spanish}"
                                                         IsChecked="{Binding IsSpanish, Mode=TwoWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,12,0,0"
                                        Padding="16"
                                        Background="{DynamicResource SurfaceSoftBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource ScrollShortcuts}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource ShortcutsHint}"
                                                   Margin="0,3,0,0"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   TextWrapping="Wrap" />

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource ScrollUp}"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold" />
                                                <Border Margin="0,5,0,0"
                                                        Padding="8,4"
                                                        HorizontalAlignment="Left"
                                                        Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                    <TextBlock Text="{Binding ScrollUpHotkeyDisplay}"
                                                               FontFamily="{StaticResource MonoFontFamily}"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Height="30"
                                                    Padding="12,0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="{Binding ScrollUpButtonText}"
                                                    Command="{Binding Commands.CaptureScrollUp}" />
                                        </Grid>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource ScrollDown}"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold" />
                                                <Border Margin="0,5,0,0"
                                                        Padding="8,4"
                                                        HorizontalAlignment="Left"
                                                        Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                    <TextBlock Text="{Binding ScrollDownHotkeyDisplay}"
                                                               FontFamily="{StaticResource MonoFontFamily}"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Height="30"
                                                    Padding="12,0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="{Binding ScrollDownButtonText}"
                                                    Command="{Binding Commands.CaptureScrollDown}" />
                                        </Grid>

                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock Text="{DynamicResource HudShortcut}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold" />
                                            <Border Margin="0,5,0,0"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                <TextBlock Text="{Binding HudShortcutLabel}"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding SettingsStatusMessage}"
                                                   Margin="0,12,0,0"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasSettingsStatus, Converter={StaticResource BooleanToVisibility}}" />

                                        <Button Margin="0,14,0,0"
                                                HorizontalAlignment="Left"
                                                Height="30"
                                                Padding="12,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="{DynamicResource ResetDefaults}"
                                                Command="{Binding Commands.ResetSettings}" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,12,0,0"
                                        Padding="16"
                                        Background="{DynamicResource SurfaceSoftBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource PageLayout}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource LayoutHint}"
                                                   Margin="0,3,0,0"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <TextBlock Text="{DynamicResource SplitLayoutDisabledHint}"
                                                   Margin="0,3,0,0"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   Visibility="{Binding IsAutoMaximizeEnabled, Converter={StaticResource BooleanToVisibility}}" />
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,10,0,0"
                                                    IsEnabled="{Binding IsSplitLayoutAvailable}">
                                            <RadioButton GroupName="PageLayoutChoice"
                                                         Style="{StaticResource FilterChipStyle}"
                                                         Content="{DynamicResource LayoutAuto}"
                                                         IsChecked="{Binding IsLayoutAuto, Mode=TwoWay}" />
                                            <RadioButton GroupName="PageLayoutChoice"
                                                         Margin="6,0,0,0"
                                                         Style="{StaticResource FilterChipStyle}"
                                                         Content="{DynamicResource LayoutColumns}"
                                                         IsChecked="{Binding IsLayoutColumns, Mode=TwoWay}" />
                                            <RadioButton GroupName="PageLayoutChoice"
                                                         Margin="6,0,0,0"
                                                         Style="{StaticResource FilterChipStyle}"
                                                         Content="{DynamicResource LayoutRows}"
                                                         IsChecked="{Binding IsLayoutRows, Mode=TwoWay}" />
                                            <RadioButton GroupName="PageLayoutChoice"
                                                         Margin="6,0,0,0"
                                                         Style="{StaticResource FilterChipStyle}"
                                                         Content="{DynamicResource LayoutGrid}"
                                                         IsChecked="{Binding IsLayoutGrid, Mode=TwoWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource CardStyle}"
                            Padding="20"
                            CornerRadius="16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LayoutPreview}"
                                       FontFamily="{StaticResource DisplayFontFamily}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource LayoutPreviewHint}"
                                       Margin="0,4,0,0"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       TextWrapping="Wrap" />
                            <Border Margin="0,18,0,0"
                                    Height="190"
                                    Padding="12"
                                    Background="{DynamicResource SurfaceSoftBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <controls:PageLayoutPreview WindowCount="4"
                                                            Layout="{Binding PageLayout}"
                                                            AccentBrush="{DynamicResource AccentBrush}"
                                                            SlotBrush="{DynamicResource SurfaceBrush}" />
                            </Border>
                            <TextBlock Margin="0,16,0,0"
                                       Text="{DynamicResource HudShortcutFixed}"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============================ FOOTER ============================ -->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Height="22"
                                    Padding="8,0"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TextBlock Text="{Binding ScrollShortcutHint}"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <Border Height="22"
                                    Margin="6,0,0,0"
                                    Padding="8,0"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TextBlock Text="{Binding HudShortcutBadge}"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <Ellipse Width="5" Height="5" Margin="9,0,5,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HotkeyReady}" Value="False">
                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding HotkeyStatusLabel}"
                                       FontSize="7.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       ToolTip="{Binding HotkeyDetail}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource LocalOnly}"
                                       FontSize="7.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="  ·  "
                                       FontSize="7.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="{DynamicResource NoNetwork}"
                                       FontSize="7.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="  ·  "
                                       FontSize="7.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="{Binding EngineLabel}"
                                       FontSize="7.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="  ·  "
                                       FontSize="7.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="{Binding TelemetryLabel}"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="7.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding SessionStartLabel}"
                                       FontSize="7.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="  ·  "
                                       FontSize="7.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="{Binding BuildLabel}"
                                       FontSize="7.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
