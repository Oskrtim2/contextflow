<Window x:Class="ContextFlow.Views.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ContextFlow.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ContextFlow"
        Width="1320"
        Height="820"
        MinWidth="1160"
        MinHeight="640"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource BodyFontFamily}"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding Commands.Collapse}" />
        <KeyBinding Key="F" Modifiers="Control+Shift" Command="{Binding Commands.OptimizeNow}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="CapsuleActiveStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource CapsuleTileStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{Binding AccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <Border x:Name="Shell"
                Background="{DynamicResource HudBackgroundBrush}"
                BorderBrush="{DynamicResource WindowBorderBrush}"
                BorderThickness="1"
                CornerRadius="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>

                <!-- ============================ HEADER ============================ -->
                <Grid x:Name="HeaderBar"
                      Grid.Row="0"
                      Background="Transparent"
                      MouseLeftButtonDown="HeaderBar_OnMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="22,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="36"
                                Height="36"
                                Background="{DynamicResource AccentGradientBrush}"
                                CornerRadius="11">
                            <Grid Width="22" Height="18">
                                <Border Height="2.6"
                                        VerticalAlignment="Top"
                                        Background="#F2FFFFFF"
                                        CornerRadius="1.3" />
                                <Border Height="2.2"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Background="#8CFFFFFF"
                                        CornerRadius="1.1" />
                                <Border Height="2.6"
                                        VerticalAlignment="Bottom"
                                        Background="#F2FFFFFF"
                                        CornerRadius="1.3" />
                                <Ellipse Width="5.5"
                                         Height="5.5"
                                         Margin="0,0,0,0"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Fill="#F2C45A" />
                            </Grid>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ContextFlow"
                                       FontFamily="{StaticResource DisplayFontFamily}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="CONTEXTUAL ENVIRONMENT MANAGER"
                                       Margin="0,2,0,0"
                                       FontSize="8"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Margin="0,0,16,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border x:Name="AiStatusChip"
                                Height="30"
                                Margin="0,0,10,0"
                                Padding="10,0"
                                CornerRadius="8"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOptimizationEnabled}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOptimizationEnabled}" Value="False">
                                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="LOCAL AI"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding AiStatusText}"
                                           Margin="5,0,0,0"
                                           FontSize="8.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <Border.ToolTip>
                                <TextBlock Text="{Binding AiStatusDetail}" />
                            </Border.ToolTip>
                        </Border>

                        <Button Style="{StaticResource IconButtonStyle}"
                                Content="{Binding ThemeIconGlyph}"
                                FontFamily="Segoe UI Symbol"
                                FontSize="15"
                                AutomationProperties.Name="Toggle light or dark theme"
                                Command="{Binding Commands.ToggleTheme}"
                                ToolTip="Switch light / dark theme" />
                        <Button Height="32"
                                Margin="8,0,8,0"
                                Padding="13,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="OPTIMIZE NOW"
                                FontSize="9.5"
                                Command="{Binding Commands.OptimizeNow}"
                                ToolTip="Run one local AI optimization pass now (Ctrl+Shift+F)" />
                        <Button x:Name="MaximizeButton"
                                Margin="0,0,8,0"
                                Style="{StaticResource IconButtonStyle}"
                                Content="□"
                                FontFamily="Segoe UI Symbol"
                                FontSize="14"
                                AutomationProperties.Name="Maximize or restore HUD"
                                Click="MaximizeButton_OnClick"
                                ToolTip="Maximize / restore (double-click header)" />
                        <Button Style="{StaticResource IconButtonStyle}"
                                Content="—"
                                FontFamily="{StaticResource BodyFontFamily}"
                                FontSize="16"
                                AutomationProperties.Name="Collapse HUD to floating bubble"
                                Command="{Binding Commands.Collapse}"
                                ToolTip="Collapse to floating bubble (Esc)" />
                    </StackPanel>
                </Grid>

                <!-- ============================ BODY ============================ -->
                <Grid Grid.Row="1" Margin="18,16,18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="244" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="294" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT RAIL -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="2,0,2,8">
                            <StackPanel>
                                <TextBlock Text="WORKFLOW CAPSULES" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="{Binding CapsuleSummary}"
                                           Margin="0,3,0,0"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource IconButtonStyle}"
                                    Width="28"
                                    Height="28"
                                    Content="+"
                                    FontSize="17"
                                    AutomationProperties.Name="Create workflow capsule"
                                    Command="{Binding Commands.AddCapsule}"
                                    ToolTip="Create a new workflow capsule" />
                        </Grid>

                        <Border Grid.Row="1"
                                Style="{StaticResource CardStyle}"
                                Padding="8"
                                CornerRadius="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <ItemsControl ItemsSource="{Binding Capsules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource CapsuleActiveStyle}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Activate capsule {0}}"
                                                    Command="{Binding DataContext.Commands.ActivateCapsule, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Activate this capsule and route its windows to the target display">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="4"
                                                            Height="32"
                                                            Background="{Binding AccentBrush}"
                                                            CornerRadius="2" />
                                                    <StackPanel Grid.Column="1" Margin="10,0,6,0">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="11.5"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <Border Margin="7,0,0,0"
                                                                    Padding="5,1"
                                                                    Background="{Binding AccentSoftBrush}"
                                                                    CornerRadius="4">
                                                                <TextBlock Text="ACTIVE"
                                                                           FontSize="7.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="{Binding AccentBrush}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="{x:Type TextBlock}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </DockPanel>
                                                        <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                            <TextBlock Text="{Binding WindowCountText}"
                                                                       FontSize="9"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="  ·  "
                                                                       FontSize="9"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                                            <TextBlock Text="{Binding TargetDisplayLabel}"
                                                                       Width="116"
                                                                       FontSize="9"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Ellipse Grid.Column="2"
                                                             Width="7"
                                                             Height="7"
                                                             Margin="0,0,2,0"
                                                             Fill="{Binding AccentBrush}"
                                                             VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="{x:Type Ellipse}">
                                                                <Setter Property="Opacity" Value="0.22" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Display router -->
                        <Border Grid.Row="2"
                                Style="{StaticResource CardStyle}"
                                Margin="0,12,0,0"
                                Padding="14,12"
                                CornerRadius="14">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="ROUTE ACTIVE CAPSULE" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBlock HorizontalAlignment="Right"
                                               Text="DRAG"
                                               FontSize="7.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </Grid>
                                <controls:MonitorRouteControl Height="58"
                                                              Margin="0,9,0,0"
                                                              AutomationProperties.Name="Active capsule monitor router"
                                                              ItemsSource="{Binding Displays}"
                                                              SelectedIndex="{Binding ActiveDisplayIndex, Mode=TwoWay}"
                                                              AccentBrush="{DynamicResource AccentBrush}"
                                                              TrackBrush="{DynamicResource SurfaceMutedBrush}"
                                                              SurfaceBrush="{DynamicResource SurfaceBrush}"
                                                              TextBrush="{DynamicResource TextPrimaryBrush}"
                                                              MutedTextBrush="{DynamicResource TextSecondaryBrush}"
                                                              BorderBrush="{DynamicResource BorderBrush}" />
                                <TextBlock Text="{Binding ActiveCapsuleDisplayLabel}"
                                           Margin="0,7,0,0"
                                           FontSize="9"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- AI control -->
                        <Border Grid.Row="3"
                                Style="{StaticResource CardStyle}"
                                Margin="0,12,0,0"
                                Padding="14,12"
                                CornerRadius="14">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="LOCAL AI OPTIMIZER" Style="{StaticResource EyebrowTextStyle}" />
                                    <Border HorizontalAlignment="Right"
                                            Padding="6,1"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="4">
                                        <TextBlock Text="{Binding EngineLabel}"
                                                   FontSize="7.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="Offline policy · no cloud calls"
                                           Margin="0,3,0,0"
                                           FontSize="9"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Auto optimize"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Throttle idle capsules"
                                                   FontSize="8.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Style="{StaticResource SwitchToggleStyle}"
                                                  AutomationProperties.Name="Toggle automatic AI optimization"
                                                  IsChecked="{Binding IsOptimizationEnabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Enable local AI priority and working-set optimization" />
                                </Grid>

                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Capsule isolation"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Cloak or minimize hidden capsules"
                                                   FontSize="8.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Style="{StaticResource SwitchToggleStyle}"
                                                  AutomationProperties.Name="Toggle inactive capsule isolation"
                                                  IsChecked="{Binding IsCapsuleIsolationEnabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Opt-in: hides inactive capsule windows. Tries DWM cloaking first; if Windows denies cross-process cloaking, uses a reversible minimize and restores it on capsule activation or exit." />
                                </Grid>

                                <DockPanel Margin="0,11,0,0">
                                    <Button DockPanel.Dock="Right"
                                            Height="28"
                                            Padding="10,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            FontSize="9"
                                            Content="RUN PASS"
                                            Command="{Binding Commands.OptimizeNow}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Working set + priority"
                                                   FontSize="8.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding IsolationStatusText}"
                                                   FontSize="7.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- CENTER -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="154" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- CPU -->
                            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{DynamicResource CpuBrush}" />
                                            <TextBlock Text="CPU" Style="{StaticResource EyebrowTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Text="LIVE"
                                                   HorizontalAlignment="Right"
                                                   FontSize="7.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="68" Height="68" VerticalAlignment="Center">
                                            <controls:GaugeArc Value="{Binding CpuPercent}"
                                                               AccentBrush="{DynamicResource CpuBrush}"
                                                               TrackBrush="{DynamicResource TrackBrush}" />
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CpuValueText}"
                                                           FontFamily="{StaticResource DisplayFontFamily}"
                                                           FontSize="20"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="%"
                                                           Margin="1,6,0,0"
                                                           FontSize="8"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CpuDetail}"
                                                       FontSize="8.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                            <controls:Sparkline Height="23"
                                                                Margin="0,5,0,0"
                                                                Points="{Binding CpuHistory}"
                                                                StrokeBrush="{DynamicResource CpuBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- RAM -->
                            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="6,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{DynamicResource RamBrush}" />
                                            <TextBlock Text="MEMORY" Style="{StaticResource EyebrowTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Text="RAM"
                                                   HorizontalAlignment="Right"
                                                   FontSize="7.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="68" Height="68" VerticalAlignment="Center">
                                            <controls:GaugeArc Value="{Binding RamPercent}"
                                                               AccentBrush="{DynamicResource RamBrush}"
                                                               TrackBrush="{DynamicResource TrackBrush}" />
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RamValueText}"
                                                           FontFamily="{StaticResource DisplayFontFamily}"
                                                           FontSize="20"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="%"
                                                           Margin="1,6,0,0"
                                                           FontSize="8"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RamDetail}"
                                                       FontSize="8.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                            <controls:Sparkline Height="23"
                                                                Margin="0,5,0,0"
                                                                Points="{Binding RamHistory}"
                                                                StrokeBrush="{DynamicResource RamBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- GPU -->
                            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="6,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{DynamicResource GpuBrush}" />
                                            <TextBlock Text="GPU" Style="{StaticResource EyebrowTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Text="PDH"
                                                   HorizontalAlignment="Right"
                                                   FontSize="7.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="68" Height="68" VerticalAlignment="Center">
                                            <controls:GaugeArc Value="{Binding GpuPercent}"
                                                               AccentBrush="{DynamicResource GpuBrush}"
                                                               TrackBrush="{DynamicResource TrackBrush}" />
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GpuValueText}"
                                                           FontFamily="{StaticResource DisplayFontFamily}"
                                                           FontSize="20"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="%"
                                                           Margin="1,6,0,0"
                                                           FontSize="8"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GpuDetail}"
                                                       FontSize="8.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                            <controls:Sparkline Height="23"
                                                                Margin="0,5,0,0"
                                                                Points="{Binding GpuHistory}"
                                                                StrokeBrush="{DynamicResource GpuBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Windows -->
                            <Border Grid.Column="3"
                                    Margin="6,0,0,0"
                                    Padding="14"
                                    CornerRadius="15"
                                    BorderThickness="0"
                                    Background="{DynamicResource AccentGradientBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <TextBlock Text="MANAGED WINDOWS"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="#D9FFFFFF" />
                                        <Ellipse Width="6"
                                                 Height="6"
                                                 HorizontalAlignment="Right"
                                                 Fill="#E6FFFFFF" />
                                    </DockPanel>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WindowCountText}"
                                                   FontFamily="{StaticResource DisplayFontFamily}"
                                                   FontSize="37"
                                                   FontWeight="SemiBold"
                                                   Foreground="White" />
                                        <TextBlock Text="{Binding WindowSummaryText}"
                                                   Margin="0,-2,0,0"
                                                   FontSize="8.5"
                                                   Foreground="#D9FFFFFF"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <Border Width="5" Height="5" CornerRadius="2.5" Background="#F2C45A" VerticalAlignment="Center" />
                                        <TextBlock Text=" ACROSS ALL CAPSULES"
                                                   FontSize="7.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#D9FFFFFF" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Process matrix -->
                        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" CornerRadius="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="34" />
                                </Grid.RowDefinitions>

                                <Grid Margin="16,12,16,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="PROCESS MATRIX" Style="{StaticResource EyebrowTextStyle}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="Application windows"
                                                       FontFamily="{StaticResource DisplayFontFamily}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <Border Margin="8,0,0,0"
                                                    Padding="6,1"
                                                    Background="{DynamicResource SurfaceMutedBrush}"
                                                    CornerRadius="5"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding VisibleWindowCountText}"
                                                           FontSize="8"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="158"
                                                Height="28"
                                                Margin="0,0,8,0"
                                                Padding="8,0"
                                                Background="{DynamicResource InputBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="⌕"
                                                           Margin="0,0,5,0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe UI Symbol"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                                <Grid Grid.Column="1">
                                                    <TextBox x:Name="SearchBox"
                                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                             VerticalAlignment="Center"
                                                             AutomationProperties.Name="Filter managed windows"
                                                             ToolTip="Search by title, process, or capsule" />
                                                    <TextBlock Text="Filter windows…"
                                                               IsHitTestVisible="False"
                                                               VerticalAlignment="Center"
                                                               FontSize="9.5"
                                                               Foreground="{DynamicResource TextTertiaryBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <RadioButton Content="ALL"
                                                     GroupName="WindowFilter"
                                                     Margin="0,0,5,0"
                                                     Style="{StaticResource FilterChipStyle}"
                                                     IsChecked="{Binding IsAllFilterSelected, Mode=TwoWay}" />
                                        <RadioButton Content="CAPSULE"
                                                     GroupName="WindowFilter"
                                                     Style="{StaticResource FilterChipStyle}"
                                                     IsChecked="{Binding IsCapsuleFilterSelected, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1"
                                        Margin="16,0,16,0"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="98" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="66" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1"
                                                   Text="WINDOW"
                                                   Style="{StaticResource EyebrowTextStyle}"
                                                   FontSize="8"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="CAPSULE"
                                                   Style="{StaticResource EyebrowTextStyle}"
                                                   FontSize="8"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="MONITOR"
                                                   Style="{StaticResource EyebrowTextStyle}"
                                                   FontSize="8"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4"
                                                   Text="POSITION"
                                                   Style="{StaticResource EyebrowTextStyle}"
                                                   FontSize="8"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5"
                                                   Text="STATE"
                                                   Style="{StaticResource EyebrowTextStyle}"
                                                   FontSize="8"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <ListView x:Name="ProcessList"
                                          Grid.Row="2"
                                          ItemsSource="{Binding WindowsView}"
                                          MouseDoubleClick="ProcessList_OnMouseDoubleClick"
                                          SelectionMode="Single"
                                          IsSynchronizedWithCurrentItem="False">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="54"
                                                    Padding="16,0"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="98" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="66" />
                                                        <ColumnDefinition Width="28" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="26"
                                                            Height="26"
                                                            Background="{Binding CapsuleSoftBrush}"
                                                            CornerRadius="7"
                                                            VerticalAlignment="Center">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Initial}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding CapsuleBrush}" />
                                                            <Image Source="{Binding Icon}"
                                                                   Width="18"
                                                                   Height="18"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="1"
                                                                Margin="9,0,8,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Title}" />
                                                        <TextBlock Text="{Binding ProcessLabel}"
                                                                   Margin="0,2,0,0"
                                                                   FontSize="8.5"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource CapsulePillButtonStyle}"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="Change window capsule assignment"
                                                            Click="CapsulePill_OnClick"
                                                            ToolTip="Assign this window to another capsule">
                                                        <Border Height="21"
                                                                Margin="0,0,9,0"
                                                                Padding="7,0"
                                                                Background="{Binding CapsuleSoftBrush}"
                                                                CornerRadius="6">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Ellipse Width="5" Height="5" Fill="{Binding CapsuleBrush}" Margin="0,0,5,0" />
                                                                <TextBlock Text="{Binding CapsuleName}"
                                                                           FontSize="8.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{Binding CapsuleBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="54" />
                                                                <TextBlock Text="⌄"
                                                                           Margin="3,-1,0,0"
                                                                           FontSize="8"
                                                                           Foreground="{Binding CapsuleBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Button>

                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding MonitorLabel}"
                                                               VerticalAlignment="Center"
                                                               FontSize="8.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding MonitorLabel}" />

                                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CoordinatesLabel}"
                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                   FontSize="9"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding SizeLabel}"
                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                   FontSize="7.5"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="5"
                                                               Text="{Binding StatusLabel}"
                                                               VerticalAlignment="Center"
                                                               FontSize="7.5"
                                                               FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsForeground}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCloaked}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <Button Grid.Column="6"
                                                            Width="26"
                                                            Height="26"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Content="↗"
                                                            FontFamily="Segoe UI Symbol"
                                                            FontSize="11"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="Focus window"
                                                            Command="{Binding DataContext.Commands.FocusWindow, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Focus window and collapse HUD" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Grid Grid.Row="2"
                                      IsHitTestVisible="False"
                                      Background="Transparent"
                                      Visibility="{Binding HasNoVisibleWindows, Converter={StaticResource BooleanToVisibility}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="36"
                                                Height="36"
                                                HorizontalAlignment="Center"
                                                Background="{DynamicResource SurfaceMutedBrush}"
                                                CornerRadius="10">
                                            <TextBlock Text="⌕"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe UI Symbol"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </Border>
                                        <TextBlock Text="No windows match this view"
                                                   Margin="0,8,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Switch capsules or clear the filter."
                                                   Margin="0,2,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="3" Margin="16,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="  Double-click a row to focus its window"
                                                   FontSize="8.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Text="{Binding SystemStatusText, StringFormat=SYSTEM {0}}"
                                               FontSize="7.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- RIGHT RAIL -->
                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.18*" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0" CornerRadius="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Margin="14,12,14,8">
                                    <StackPanel>
                                        <TextBlock Text="CANVAS OVERVIEW" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="Workflow topology"
                                                   Margin="0,2,0,0"
                                                   FontFamily="{StaticResource DisplayFontFamily}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Padding="7,2"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="5">
                                        <TextBlock Text="∞ INFINITE"
                                                   FontSize="7.5"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                </Grid>
                                <Border Grid.Row="1"
                                        Margin="14,0,14,0"
                                        Background="{DynamicResource SurfaceSoftBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        ClipToBounds="True">
                                    <controls:WorkspaceMap ItemsSource="{Binding Capsules}"
                                                           AutomationProperties.Name="Infinite canvas overview"
                                                           ActiveCapsule="{Binding ActiveCapsule}"
                                                           ActivateCommand="{Binding Commands.ActivateCapsule}"
                                                           SurfaceBrush="{DynamicResource SurfaceBrush}"
                                                           BorderBrush="{DynamicResource BorderBrush}"
                                                           TextPrimaryBrush="{DynamicResource TextPrimaryBrush}"
                                                           TextSecondaryBrush="{DynamicResource TextSecondaryBrush}"
                                                           AccentBrush="{DynamicResource AccentBrush}"
                                                           GridBrush="{DynamicResource GridBrush}" />
                                </Border>
                                <TextBlock Grid.Row="2"
                                           Margin="14,7,14,10"
                                           Text="Drag to pan · Ctrl+wheel to zoom · double-click to fit"
                                           FontSize="7.8"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" CornerRadius="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="14,12,14,8">
                                    <StackPanel>
                                        <TextBlock Text="AI ACTIVITY" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="Local policy journal"
                                                   Margin="0,2,0,0"
                                                   FontFamily="{StaticResource DisplayFontFamily}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Padding="6,1"
                                            Background="{DynamicResource SurfaceMutedBrush}"
                                            CornerRadius="5">
                                        <TextBlock Text="ON DEVICE"
                                                   FontSize="7.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                                <ScrollViewer Grid.Row="1"
                                              Margin="0,0,0,7"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False">
                                    <ItemsControl ItemsSource="{Binding Activity}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="14,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="24"
                                                            Height="24"
                                                            VerticalAlignment="Top"
                                                            Background="{DynamicResource SurfaceMutedBrush}"
                                                            CornerRadius="7">
                                                        <TextBlock Text="{Binding IconGlyph}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontFamily="Segoe UI Symbol"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0,6,0">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="{Binding ActionLabel}"
                                                                       FontSize="9.5"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="  ·  "
                                                                       FontSize="8"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                                            <TextBlock Text="{Binding ProcessName}"
                                                                       FontSize="8.5"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Detail}"
                                                                   Margin="0,1,0,0"
                                                                   FontSize="8"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Detail}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding TimeLabel}"
                                                               FontFamily="{StaticResource MonoFontFamily}"
                                                               FontSize="7.5"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               VerticalAlignment="Top" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ============================ FOOTER ============================ -->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Height="22"
                                    Padding="8,0"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TextBlock Text="Ctrl + E + F"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="8.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <Ellipse Width="5" Height="5" Margin="9,0,5,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HotkeyReady}" Value="False">
                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding HotkeyStatusLabel}"
                                       FontSize="7.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       ToolTip="{Binding HotkeyDetail}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="100% LOCAL"
                                       FontSize="7.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="  ·  NO NETWORK REQUESTS"
                                       FontSize="7.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="  ·  "
                                       FontSize="7.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="{Binding EngineLabel}"
                                       FontSize="7.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="  ·  "
                                       FontSize="7.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="{Binding LastTelemetryLabel, StringFormat=TELEMETRY {0}}"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="7.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding SessionStartLabel}"
                                       FontSize="7.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="  ·  "
                                       FontSize="7.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="{Binding BuildLabel}"
                                       FontSize="7.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
