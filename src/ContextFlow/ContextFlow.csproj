<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>

    <AssemblyName>ContextFlow</AssemblyName>
    <RootNamespace>ContextFlow</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>

    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Company>ContextFlow</Company>
    <Product>ContextFlow</Product>
    <Authors>ContextFlow</Authors>
    <Description>ContextFlow — Contextual Environment Manager for Windows 11.</Description>
    <Copyright>Copyright © 2026 ContextFlow. All rights reserved.</Copyright>

    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- WPF owns DPI awareness through app.manifest; the WinForms tray does not
         initialize an ApplicationConfiguration and must not override it. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.1" />
  </ItemGroup>

  <!-- UseWindowsForms adds global usings for System.Drawing and WinForms that
       collide with WPF's Brush, Point, Color and Application types. The tray
       service opts into System.Drawing explicitly instead. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\policy.onnx" LogicalName="ContextFlow.Assets.policy.onnx" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\AppIcon.ico" />
  </ItemGroup>

</Project>
