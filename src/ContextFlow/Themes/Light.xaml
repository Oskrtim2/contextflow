<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ContextFlow Chrome — brushed silver hardware, chrome bevels and a blue LCD. -->

    <!-- Brushed aluminium: long horizontal streaks tiled across the shell. -->
    <DrawingBrush x:Key="HudBackgroundBrush"
                  TileMode="Tile"
                  Viewport="0,0,360,6"
                  ViewportUnits="Absolute"
                  Stretch="None"
                  AlignmentX="Left"
                  AlignmentY="Top">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#D3D8DE" Geometry="M0,0 H360 V6 H0 Z" />
                <GeometryDrawing Brush="#DEE2E7" Geometry="M0,0 H170 V1 H0 Z" />
                <GeometryDrawing Brush="#C9CFD6" Geometry="M120,1 H360 V2 H120 Z" />
                <GeometryDrawing Brush="#E1E5EA" Geometry="M0,2 H70 V3 H0 Z M230,2 H360 V3 H230 Z" />
                <GeometryDrawing Brush="#CCD2D9" Geometry="M40,3 H290 V4 H40 Z" />
                <GeometryDrawing Brush="#DADFE4" Geometry="M0,4 H210 V5 H0 Z" />
                <GeometryDrawing Brush="#C7CDD4" Geometry="M150,5 H360 V6 H150 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Light falloff laid over the brushed shell. -->
    <LinearGradientBrush x:Key="MetalSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#70FFFFFF" Offset="0" />
        <GradientStop Color="#18FFFFFF" Offset="0.35" />
        <GradientStop Color="#00FFFFFF" Offset="0.6" />
        <GradientStop Color="#26000000" Offset="1" />
    </LinearGradientBrush>

    <!-- Chrome title band. -->
    <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FDFEFF" Offset="0" />
        <GradientStop Color="#E4E8ED" Offset="0.45" />
        <GradientStop Color="#C7CED6" Offset="0.52" />
        <GradientStop Color="#D6DCE3" Offset="0.85" />
        <GradientStop Color="#AEB6C0" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#C9CFD6" />

    <!-- Raised metal panels. -->
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F7F9FB" Offset="0" />
        <GradientStop Color="#E7EBF0" Offset="0.5" />
        <GradientStop Color="#D9DFE6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceSoftBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EEF1F5" Offset="0" />
        <GradientStop Color="#E0E5EB" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#D6DCE3" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#F3F5F8" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />

    <!-- Bevels: light from the top-left, shadow to the bottom-right. -->
    <SolidColorBrush x:Key="BorderBrush" Color="#AEB6C0" />
    <LinearGradientBrush x:Key="BevelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#A9B2BD" Offset="0.5" />
        <GradientStop Color="#6F7986" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#6E7884" />
    <LinearGradientBrush x:Key="WindowBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#9AA3AE" Offset="0.5" />
        <GradientStop Color="#58616C" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="InsetBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#56606C" Offset="0" />
        <GradientStop Color="#9AA4B0" Offset="0.6" />
        <GradientStop Color="#FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#121820" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#3C4552" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#5C6673" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="EngraveBrush" Color="#B3FFFFFF" />

    <SolidColorBrush x:Key="AccentBrush" Color="#1F55D6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3A6CF0" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#173FA8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#D4E0FA" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#7F9DE8" />

    <SolidColorBrush x:Key="CpuBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="RamBrush" Color="#0B8F80" />
    <SolidColorBrush x:Key="GpuBrush" Color="#C7741F" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#0F8A57" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#D2EEDF" />
    <SolidColorBrush x:Key="WarningBrush" Color="#A86000" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#F3E3C2" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C8302A" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#F3D6D4" />

    <!-- Slider groove. -->
    <LinearGradientBrush x:Key="TrackBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7D8794" Offset="0" />
        <GradientStop Color="#A7B0BB" Offset="0.5" />
        <GradientStop Color="#C9D0D8" Offset="1" />
    </LinearGradientBrush>

    <!-- Chrome knob for switches and round buttons. -->
    <RadialGradientBrush x:Key="ToggleThumbBrush" GradientOrigin="0.35,0.25" Center="0.45,0.4" RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#E3E7EC" Offset="0.45" />
        <GradientStop Color="#A3ACB7" Offset="0.9" />
        <GradientStop Color="#7C8693" Offset="1" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#E9EEF4" />
    <SolidColorBrush x:Key="SelectionOverlayBrush" Color="#D4E0FA" />
    <SolidColorBrush x:Key="GridBrush" Color="#9AA4B0" />
    <LinearGradientBrush x:Key="ScrollThumbBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F4F6F9" Offset="0" />
        <GradientStop Color="#B9C1CB" Offset="0.55" />
        <GradientStop Color="#8E98A4" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#7E8995" />
    <SolidColorBrush x:Key="BubbleFallbackBrush" Color="#D4E0FA" />
    <SolidColorBrush x:Key="GlowBrush" Color="#551F55D6" />
    <SolidColorBrush x:Key="ActivityErrorBrush" Color="#C8302A" />
    <SolidColorBrush x:Key="ActivitySuccessBrush" Color="#0F8A57" />

    <!-- Chrome buttons. -->
    <LinearGradientBrush x:Key="ChromeButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#E8ECF0" Offset="0.48" />
        <GradientStop Color="#CBD2DA" Offset="0.52" />
        <GradientStop Color="#E1E6EB" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ChromeButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F1F4F7" Offset="0.48" />
        <GradientStop Color="#D9DFE6" Offset="0.52" />
        <GradientStop Color="#EEF1F4" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ChromeButtonPressedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A9B2BD" Offset="0" />
        <GradientStop Color="#C3CAD2" Offset="0.5" />
        <GradientStop Color="#E3E7EC" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ChromeEdgeBrush" Color="#727C88" />

    <!-- Blue gel buttons (primary actions). -->
    <LinearGradientBrush x:Key="GelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#86AAFF" Offset="0" />
        <GradientStop Color="#4677F2" Offset="0.48" />
        <GradientStop Color="#1F4FD2" Offset="0.52" />
        <GradientStop Color="#3266E6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GelHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A3BEFF" Offset="0" />
        <GradientStop Color="#5C89FA" Offset="0.48" />
        <GradientStop Color="#2C5DE0" Offset="0.52" />
        <GradientStop Color="#4677F2" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GelPressedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#173FA8" Offset="0" />
        <GradientStop Color="#2453C9" Offset="0.6" />
        <GradientStop Color="#3B6BE8" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GelEdgeBrush" Color="#0F2E86" />
    <LinearGradientBrush x:Key="GlossBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C8FFFFFF" Offset="0" />
        <GradientStop Color="#30FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2F63E8" Offset="0" />
        <GradientStop Color="#173A9E" Offset="0.55" />
        <GradientStop Color="#0B1F63" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HudAmbientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E9ECF0" Offset="0" />
        <GradientStop Color="#C9CFD6" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="BubbleGradientBrush" GradientOrigin="0.4,0.25" Center="0.5,0.45" RadiusX="0.7" RadiusY="0.7">
        <GradientStop Color="#9DBBFF" Offset="0" />
        <GradientStop Color="#3D6FF0" Offset="0.45" />
        <GradientStop Color="#1739A6" Offset="0.85" />
        <GradientStop Color="#0B1F63" Offset="1" />
    </RadialGradientBrush>
</ResourceDictionary>
