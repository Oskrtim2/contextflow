<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ContextFlow Light — the primary design surface. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="HudBackgroundBrush" Color="#F5F8FAFC" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#D5DEE9" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#6366F1" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4F46E5" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4338CA" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEF2FF" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#C7D2FE" />
    <SolidColorBrush x:Key="CpuBrush" Color="#6366F1" />
    <SolidColorBrush x:Key="RamBrush" Color="#14B8A6" />
    <SolidColorBrush x:Key="GpuBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#ECFDF5" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFFBEB" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEF2F2" />
    <SolidColorBrush x:Key="TrackBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="SelectionOverlayBrush" Color="#EEF2FF" />
    <SolidColorBrush x:Key="GridBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="BubbleFallbackBrush" Color="#EEF2FF" />
    <SolidColorBrush x:Key="GlowBrush" Color="#336366F1" />
    <SolidColorBrush x:Key="ActivityErrorBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="ActivitySuccessBrush" Color="#059669" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="0.65" />
        <GradientStop Color="#D946EF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HudAmbientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EEF2FF" Offset="0" />
        <GradientStop Color="#F8FAFC" Offset="0.45" />
        <GradientStop Color="#F5F3FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BubbleGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EE6366F1" Offset="0" />
        <GradientStop Color="#EE8B5CF6" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
