<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ContextFlow Gunmetal — dark brushed steel, smoked chrome and a blue LCD. -->

    <DrawingBrush x:Key="HudBackgroundBrush"
                  TileMode="Tile"
                  Viewport="0,0,360,6"
                  ViewportUnits="Absolute"
                  Stretch="None"
                  AlignmentX="Left"
                  AlignmentY="Top">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#2E333A" Geometry="M0,0 H360 V6 H0 Z" />
                <GeometryDrawing Brush="#353B43" Geometry="M0,0 H170 V1 H0 Z" />
                <GeometryDrawing Brush="#292E34" Geometry="M120,1 H360 V2 H120 Z" />
                <GeometryDrawing Brush="#383E46" Geometry="M0,2 H70 V3 H0 Z M230,2 H360 V3 H230 Z" />
                <GeometryDrawing Brush="#2A2F35" Geometry="M40,3 H290 V4 H40 Z" />
                <GeometryDrawing Brush="#333940" Geometry="M0,4 H210 V5 H0 Z" />
                <GeometryDrawing Brush="#272B31" Geometry="M150,5 H360 V6 H150 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

