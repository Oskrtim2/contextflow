<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ContextFlow Dark — cool navy with luminous indigo accents. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="HudBackgroundBrush" Color="#F20F172A" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#172033" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#243247" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#243247" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#111C2F" />
    <SolidColorBrush x:Key="BorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#475569" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#818CF8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#A5B4FC" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#6366F1" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#282A54" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#4338CA" />
    <SolidColorBrush x:Key="CpuBrush" Color="#818CF8" />
    <SolidColorBrush x:Key="RamBrush" Color="#2DD4BF" />
    <SolidColorBrush x:Key="GpuBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#0C2D2A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#322613" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#371A22" />
    <SolidColorBrush x:Key="TrackBrush" Color="#334155" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#263449" />
    <SolidColorBrush x:Key="SelectionOverlayBrush" Color="#282A54" />
    <SolidColorBrush x:Key="GridBrush" Color="#334155" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#475569" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#64748B" />
    <SolidColorBrush x:Key="BubbleFallbackBrush" Color="#1E1B4B" />
    <SolidColorBrush x:Key="GlowBrush" Color="#55818CF8" />
    <SolidColorBrush x:Key="ActivityErrorBrush" Color="#F87171" />
    <SolidColorBrush x:Key="ActivitySuccessBrush" Color="#34D399" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="0.65" />
        <GradientStop Color="#D946EF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HudAmbientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#141F38" Offset="0" />
        <GradientStop Color="#0F172A" Offset="0.5" />
        <GradientStop Color="#17152F" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BubbleGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EE6366F1" Offset="0" />
        <GradientStop Color="#EEA855F7" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
